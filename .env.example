# Bokning och betalning på houseofawesome.se mot Life Is Awesomes bokningsbackend.
# Alla tre är publika värden. Utan de två första länkar sajten vidare till lifeisawesome.se/boka.
NEXT_PUBLIC_LIA_SUPABASE_URL=
NEXT_PUBLIC_LIA_SUPABASE_ANON_KEY=
# Stripe publishable key (pk_test_… i förhandsversioner, pk_live_… i produktion).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Basic Auth för Netlifys deploy-preview och branch-deploy. Sätts per kontext i Netlify.
# Saknas lösenordet nekas alla i dessa förhandsvisningar.
PREVIEW_PASSWORD=

# Lokal utveckling: till exempel http://localhost:5173 när LIA körs lokalt.
# Vanliga produktionsbyggen använder alltid https://lifeisawesome.se.
NEXT_PUBLIC_LIA_ASSESSMENT_ORIGIN=
# Endast separat granskningsbygge: true tillåter exakt den skrivskyddade LIA-värden
# https://hoa-review--lia-professional-pr1-preview-20260829.netlify.app ovan.
# Ska inte sättas i produktionskontexten.
NEXT_PUBLIC_ASSESSMENT_REVIEW=

# Presentkortets rad om 20 % extra (koden Awesome2027). Värdet bakas in vid bygget.
# Lämna tom, eller sätt något annat än true, så visas raden inte.
# Sätt true först när LIA har deployat validate-gift-card-promo, create-checkout
# och payments-webhook med kampanjkoden. Raden döljs ändå efter 2027-11-12
# 23:59:59 Europe/Stockholm.
NEXT_PUBLIC_GIFT_PROMO_ENABLED=
